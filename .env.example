# APP
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://albom.fr"

# AUTHENTICATION (@ NEXT-AUTH)
# UN SEUL AUTH_SECRET, identique partout, stable dans le temps.
# Le changer invalide toutes les sessions ("no matching decryption secret").
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Prod uniquement (Coolify derrière reverse proxy). En local, laisser commenté
# (trustHost infère localhost).
# ⚠️ IMPORTANT (next-auth 5.0.0-beta.11) : AUTH_URL DOIT inclure le basePath
# /api/auth. Avec AUTH_URL="https://albom.fr" (sans chemin), le middleware
# construit son URL de session interne sans /api/auth → UnknownAction → la
# session n'est jamais reconnue → boucle de redirection /signin en prod.
AUTH_URL="https://albom.fr/api/auth"

GOOGLE_ID=""
GOOGLE_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# DATABASE (POSTGRES @ NEON)
# Ensure you append `sslmode=required` after the question mark in your connection string
DATABASE_URL=""

# EMAIL (@ RESEND)
RESEND_API_KEY=""
RESEND_EMAIL_FROM=""
RESEND_EMAIL_TO=""
RESEND_HOST="smtp.resend.com"
RESEND_USERNAME="resend"
RESEND_PORT="465"

# STORAGE (PHOTOS @ CLOUDFLARE R2)
# Bucket S3-compatible pour stocker les photos déposées par les clients.
# Sans ces variables, le stockage bascule sur le disque local (uploads/), qui est
# EPHEMERE sur Coolify/Docker : les photos sont perdues à chaque redéploiement.
# Endpoint au format https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="albom-ulule-cloud"
R2_REGION="auto"
# URL publique du bucket (optionnel, si tu sers les fichiers directement depuis R2)
R2_PUBLIC_URL=""
# URL publique du site, utilisée pour construire les liens /api/photo et /api/pdf
NEXT_PUBLIC_SITE_URL="https://albom.fr"
